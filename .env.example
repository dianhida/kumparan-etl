# PostgreSQL Configuration
# Copy this file to .env and update values as needed
# Never commit .env with real credentials

POSTGRES_USER=kumparan
POSTGRES_PASSWORD=kumparan
POSTGRES_DB=kumparan
POSTGRES_PORT=5432

# pgAdmin Configuration
PGADMIN_EMAIL=admin@kumparan.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# DuckDB Configuration
# For local development: data/warehouse.duckdb
# For Airflow containers: /opt/airflow/data/warehouse.duckdb
DUCKDB_PATH=/opt/airflow/data/warehouse.duckdb

# Airflow Configuration
AIRFLOW_WEBSERVER_PORT=8080
AIRFLOW_SECRET_KEY=your-secret-key-change-in-production